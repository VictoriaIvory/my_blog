# 使用说明：把本文件复制成 .env，再按下面说明填值。
#   Windows PowerShell:  Copy-Item .env.example .env
# .env 已写进 .gitignore，不会提交到 GitHub。

# 生成密钥（在项目根目录、已激活虚拟环境下执行）：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# 把输出的字符串填到下面等号后面
DJANGO_SECRET_KEY="在这里填入你自己生成的密钥"

# 开发时 True；部署到公网必须改成 False
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔。本地开发保持默认即可
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
