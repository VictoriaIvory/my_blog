# 使用说明：把本文件复制成 .env，再按下面说明填值。
#   Windows PowerShell:  Copy-Item .env.example .env
# .env 已写进 .gitignore，不会提交到 GitHub。
#
# ============================================================
#  一、本地开发（照抄下面这几行即可）
# ============================================================

# 生成密钥（在项目根目录、已激活虚拟环境下执行）：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# 把输出的字符串填到下面等号后面
DJANGO_SECRET_KEY="在这里填入你自己生成的密钥"

# 本地开发开着方便看报错；默认其实是 False（防止忘配 .env 时带 DEBUG 上线）
DJANGO_DEBUG=True

# 允许访问的域名，逗号分隔。本地开发保持默认即可
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# 本地是 http，不开启 HTTPS 相关开关
DJANGO_HTTPS=False

# ============================================================
#  二、部署到公网时（PythonAnywhere 示例，按需修改）
# ============================================================
# 把上面的三行改成：
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=你的用户名.pythonanywhere.com
#   DJANGO_HTTPS=True
#
# DJANGO_HTTPS=True 会自动打开：
#   · HTTPS 强制跳转（SECURE_SSL_REDIRECT）
#   · 反向代理头识别（SECURE_PROXY_SSL_HEADER）
#   · Cookie 只走 HTTPS（SESSION/CSRF_COOKIE_SECURE）
#   · HSTS 1 小时
# 如果是自定义域名 + 表单跨域，再用这个（逗号分隔）：
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://你的域名
